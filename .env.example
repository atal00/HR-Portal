# ==============================================================================
# VARSAKA HR DOCUMENT MANAGEMENT & VERIFICATION PORTAL
# Environment Configuration
# ==============================================================================

# Application Base URL (Used for generating canonical QR codes and verification links)
# In production, set to your production canonical domain e.g. https://varsaka.com or https://hr.varsaka.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_DOMAIN=https://varsaka.com

# Supabase Credentials (For live PostgreSQL, Auth, and Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Storage Mode ('local' or 'supabase')
# When 'local', PDFs and generated assets are stored securely in ./storage/documents
# When 'supabase', documents are stored in private Supabase Storage buckets
STORAGE_MODE=local

# Security & Session Secrets (Must be at least 32 characters in production)
SESSION_SECRET=varsaka-hr-enterprise-secure-session-secret-key-2026-xyz
COOKIE_SECURE=false # Set to true in HTTPS production environments
BREAK_GLASS_RECOVERY_KEY=your-dedicated-high-entropy-break-glass-recovery-secret
CRON_SECRET=your-dedicated-high-entropy-retention-cron-secret-2026-prod
